# Airstrike 1.0pre6a for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's SDL
# 1.2 (sdl12-compat).
#
#   make -f amiga/Makefile.amigaos dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        NDK=/path/to/OpenNDK/Include_H SDLKIT=/path/to/opengpu-sdk \
#        DEPS=/path/to/m68k-amigaos
#
# src/Makefile's program (every src/**/*.c), without sound, as Debian builds
# it: the source has no sound files. SDLKIT is the OpenGPU developer kit:
# libSDL.a, sdl12-compat on SDL2.module. It has no SDL_image 1.2: the Team's
# amiga/sdl_image_lite.c (PNG on libpng) stands in. DEPS has the Team's
# static libpng and zlib (/mnt/amigachrome/team2/deps/m68k-amigaos). The
# configuration is PROGDIR:airstrikerc (amiga/airstrikerc: the data in
# PROGDIR:data).

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
SDLKIT  ?= /mnt/amigachrome/team2/deps/opengpu-sdk
DEPS    ?= /mnt/amigachrome/team2/deps/m68k-amigaos
CC      = $(STOVE)/bin/m68k-amigaos-gcc
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
PROG    = Airstrike
OUT     = dist/Airstrike

DEFS    = -D__amigaos__ -DINLINE=inline -DROOT_CONFIG_FILE=\"PROGDIR:airstrikerc\"
INC     = -Iamiga/include/SDL -Isrc -Isrc/sprite -Isrc/support -I$(SDLKIT)/include/SDL -I$(DEPS)/include
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP -std=gnu99 -w
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDLKIT)/lib -L$(DEPS)/lib -lSDL -lpng -lz -lm

SRC     = $(sort $(shell find src -name '*.c'))
CSRC    = amiga/stack.c amiga/sdl_image_lite.c amiga/png_rgba.c
OBJS    = $(SRC:%.c=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(BUILD)/$(PROG): $(OBJS)
	$(CC) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Iamiga/include/SDL -I$(SDLKIT)/include/SDL -I$(DEPS)/include -I$(NDK) -c -o $@ $<

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DEFS) $(INC) -c -o $@ $<

# The drawer: the program, its configuration, the game's data/, ReadMe and
# the licence.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)
	cp $(BUILD)/$(PROG) $(OUT)/
	cp amiga/airstrikerc $(OUT)/airstrikerc
	cp -R data $(OUT)/data
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING.txt
	cp amiga/icons/Airstrike.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/COPYING.txt.info
	cp amiga/icons/Airstrike-drawer.info dist/Airstrike.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
